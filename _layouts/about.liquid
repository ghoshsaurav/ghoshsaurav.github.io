---
layout: default
---
<div class="post academic-home">
  <div class="academic-introduction">
    <aside class="academic-profile" aria-label="Portrait">
      <img src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}" width="200" height="250" alt="Saurav Ghosh" fetchpriority="high">
    </aside>
    <header class="academic-heading">
      <h1>
        {{ site.first_name }}
        {{ site.last_name }}
      </h1>
      <p>
        PhD Student in Computer Science<br>
        <a href="https://wustl.edu/">Washington University in St. Louis</a>
      </p>
      <nav class="academic-links" aria-label="Academic profiles">
        <a href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}">Google Scholar</a>
        <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub</a>
        <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/">LinkedIn</a>
      </nav>
      <p class="academic-email">
        Email: <a href="mailto:{{ site.data.socials.email }}">{{ site.data.socials.email }}</a>
      </p>
    </header>
    <article class="academic-content">{{ content }}</article>
  </div>
</div>
