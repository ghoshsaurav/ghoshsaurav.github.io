{% if site.bib_search %}
  <div class="publication-filter">
    <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
    <label class="sr-only" for="bibsearch">Filter publications by title, author, or keyword</label>
    <input
      type="search"
      id="bibsearch"
      spellcheck="false"
      autocomplete="off"
      class="search bibsearch-form-input"
      placeholder="Filter publications by title, author, or keyword"
    >
  </div>
{% endif %}
